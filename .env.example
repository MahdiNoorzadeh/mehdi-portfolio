# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Never expose a service-role/secret key to the browser. This app does not need one for normal CMS operations.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: required for contact submissions if using the server endpoint below.
# NEVER prefix this with NEXT_PUBLIC_. Keep it only in local/server deployment secrets.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
